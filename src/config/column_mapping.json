{
  "mapping_version": "1.1.0",
  "effective_from": "2026-09-23",
  "target_table": "public.chargements",
  "description": "Correspondance entre les en-tetes des fichiers Excel client (espagnol / portugais) et les colonnes anglaises de public.chargements. La resolution se fait sur `normalized_key`, jamais sur `source_header` brut.",
  "header_normalization": {
    "order": [
      "1. repair_mojibake: si s.encode('latin-1').decode('utf-8') reussit ET que s contient 'Ã' ou 'Â', remplacer s par le resultat",
      "2. strip_invisible: supprimer U+00AD, U+200B, U+200C, U+200D, U+2060, U+FEFF",
      "3. unicode NFKD puis suppression des marques combinantes (accents)",
      "4. casefold",
      "5. remplacer toute suite de caracteres non alphanumeriques par un seul '_'",
      "6. supprimer les '_' de tete et de fin"
    ],
    "invisible_codepoints": [
      "U+00AD",
      "U+200B",
      "U+200C",
      "U+200D",
      "U+2060",
      "U+FEFF"
    ],
    "known_source_defects": [
      "VN colonne 3 'Descricao Vei<U+00AD>culo' : le 'i' accentue a ete remplace par 'i' + tiret conditionnel invisible.",
      "VN colonne 18 'Complemento do endereÃ§o do comprador' : en-tete deja mal encode dans le fichier source (UTF-8 lu en latin-1), alors que les colonnes 16 et 17 voisines sont correctes."
    ]
  },
  "unmatched_header_policy": "Un en-tete dont la normalized_key est inconnue ne doit jamais etre devine. Le lot est rejete avec un rapport listant les en-tetes non reconnus, les colonnes attendues manquantes, et la version de mapping utilisee.",
  "generated_columns": {
    "comment": "Colonnes de public.chargements absentes des fichiers source, produites par l'ingestion.",
    "columns": [
      "id",
      "flow_type",
      "batch_id",
      "file_name",
      "file_sha256",
      "sheet_name",
      "row_number",
      "row_hash",
      "status",
      "raw_data",
      "created_at",
      "updated_at",
      "created_by",
      "updated_by"
    ]
  },
